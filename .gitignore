node_modules/
dist/
coverage/
*.log
npm-debug.log*
*.tsbuildinfo

# NexusMem's own on-disk memory lives here and is machine-local by design.
# (Also covers any repo used as a manual test fixture under this tree.)
.nexusmem/

# Defense in depth: never let a stray database, even outside .nexusmem/, land in git.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets and machine-local env config -- never committed, ever.
.env
.env.*
!.env.example

# Private planning notes. Deliberately kept out of the repository: this is a
# public remote, so anything committed here is published permanently, and the
# roadmap is not something the project wants to publish.
#
# Being untracked also keeps it out of NexusMem's own corpus for free -- the
# docs collector reads `git ls-files -- '*.md'`, so an ignored file is never
# indexed and can never surface in a packed context block.
ROADMAP.local.md
*.local.md

# Raw per-query benchmark output (scripts/benchmark.ts) -- machine- and
# run-dependent; the reproducible artifact is the script itself plus the
# summary numbers committed into README.md.
/bench/results/

# Raw per-run eval output (scripts/eval.ts) -- machine-dependent; the
# reproducible artifact is the script plus eval/queries.json, which IS
# tracked (it's the ground truth, not a run result).
/eval/results/

# Editor / OS cruft. Anchored to the repo root: vscode-extension/.vscode/
# holds real, committed debug config (launch.json) for developing the
# extension itself, not personal editor settings.
/.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local session settings (permissions etc.) -- machine-specific,
# not meant to be shared. .claude/settings.json (without .local) is fine to
# track if the project ever wants shared skill/permission config.
.claude/settings.local.json

{
  "name": "nexusmem-vscode",
  "displayName": "NexusMem",
  "description": "Search a NexusMem-tracked repository's remembered history (git, diffs, shell, docs, conversations, github issues/PRs) from the command palette, a sidebar of what's been remembered lately, an in-editor sync command, and a proactive check when a terminal command fails.",
  "version": "0.1.0",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaminbkk/NexusMem.git",
    "directory": "vscode-extension"
  },
  "publisher": "yaminbkk",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nexusmem",
    "memory",
    "mcp",
    "search"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "nexusmem.searchMemory",
        "title": "NexusMem: Search Memory"
      },
      {
        "command": "nexusmem.refreshRecentMemory",
        "title": "NexusMem: Refresh Recent Memory",
        "icon": "$(refresh)"
      },
      {
        "command": "nexusmem.syncProject",
        "title": "NexusMem: Sync Memory",
        "icon": "$(sync)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nexusmem.recentMemory",
          "name": "NexusMem: Recent Memory"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "nexusmem.syncProject",
          "when": "view == nexusmem.recentMemory",
          "group": "navigation@1"
        },
        {
          "command": "nexusmem.refreshRecentMemory",
          "when": "view == nexusmem.recentMemory",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "NexusMem",
      "properties": {
        "nexusmem.cliPath": {
          "type": "string",
          "default": "nexusmem",
          "description": "Executable used to launch NexusMem's MCP server (`<cliPath> mcp`). Defaults to the globally installed `nexusmem` binary (`npm install -g nexusmem`). Set to an absolute path to use a different build."
        },
        "nexusmem.liveFailureDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "When a command in an integrated terminal fails, check NexusMem's memory for a past failure/fix and show a notification if one is found. Requires VS Code's terminal shell integration to be active for your shell."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run typecheck",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
